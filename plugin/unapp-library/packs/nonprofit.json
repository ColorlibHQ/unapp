			"content": "<!-- wp:group {\"align\":\"full\",\"gradient\":\"primary-to-accent\",\"textColor\":\"base\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"0\"},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|base\"}},\"heading\":{\"color\":{\"text\":\"var:preset|color|base\"}}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull has-primary-to-accent-gradient-background has-background has-base-color has-text-color has-link-color\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);\">\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"720px\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:heading {\"textAlign\":\"center\",\"textColor\":\"base\",\"fontSize\":\"xx-large\"} -->\n<h2 class=\"wp-block-heading has-text-align-center has-base-color has-text-color has-xx-large-font-size\">Three pounds buys a hot meal and somewhere warm to eat it</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"align\":\"center\",\"fontSize\":\"large\",\"style\":{\"color\":{\"text\":\"rgba(255,255,255,0.86)\"}}} -->\n<p class=\"has-text-align-center has-text-color has-large-font-size\" style=\"color:rgba(255,255,255,0.86);\">Every donation is spent in this county, usually within the fortnight.</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons {\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|20\"}}},\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\" style=\"margin-top:var(--wp--preset--spacing--20);\">\n<!-- wp:button {\"textColor\":\"contrast\",\"backgroundColor\":\"base\"} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-contrast-color has-text-color has-base-background-color has-background wp-element-button\" href=\"#donate\">Donate now</a></div>\n<!-- /wp:button -->\n<!-- wp:button {\"className\":\"is-style-outline\",\"textColor\":\"base\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link has-base-color has-text-color wp-element-button\" href=\"#volunteer\">Other ways to help</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->"
