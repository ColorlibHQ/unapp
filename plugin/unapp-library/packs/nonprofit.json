		{
			"slug": "nonprofit-hero",
			"title": "Charity: introduction",
			"categories": [
				"unapp",
				"unapp_nonprofit"
			],
			"inserter": true,
			"content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"0\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);\">\n<!-- wp:columns {\"verticalAlignment\":\"center\",\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|60\",\"left\":\"var:preset|spacing|60\"}}}} -->\n<div class=\"wp-block-columns are-vertically-aligned-center alignwide\">\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"55%\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}}} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:55%;\">\n<!-- wp:paragraph {\"align\":\"left\",\"textColor\":\"primary\",\"fontFamily\":\"heading\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.12em\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-text-align-left has-primary-color has-text-color has-heading-font-family has-small-font-size\" style=\"font-weight:600;letter-spacing:0.12em;text-transform:uppercase;\">Registered charity 1099231</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"fontSize\":\"xxx-large\",\"style\":{\"typography\":{\"lineHeight\":\"1.05\"}}} -->\n<h2 class=\"wp-block-heading has-xxx-large-font-size\" style=\"line-height:1.05;\">Nobody in this county should have to choose between heating and eating</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"large\"} -->\n<p class=\"has-muted-color has-text-color has-large-font-size\">We run four food banks, a debt advice line and a warm room every winter. Last year eleven thousand people used one of them.</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\">\n<!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#donate\">Donate</a></div>\n<!-- /wp:button -->\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#volunteer\">Volunteer</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"45%\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}}} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:45%;\">\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"style\":{\"border\":{\"radius\":\"20px\"}}} -->\n<figure class=\"wp-block-image size-full has-custom-border\"><img src=\"{{THEME}}/assets/images/abstract/gathering.svg\" alt=\"Volunteers\" style=\"border-radius:20px;\"/></figure>\n<!-- /wp:image -->\n</div>\n<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->"
		},
		{
			"slug": "nonprofit-impact",
			"title": "Charity: impact",
			"categories": [
				"unapp",
				"unapp_nonprofit"
			],
			"inserter": true,
			"content": "<!-- wp:group {\"align\":\"full\",\"className\":\"is-style-section-soft\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull is-style-section-soft\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);\">\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"680px\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"align\":\"center\",\"textColor\":\"primary\",\"fontFamily\":\"heading\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.12em\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-text-align-center has-primary-color has-text-color has-heading-font-family has-small-font-size\" style=\"font-weight:600;letter-spacing:0.12em;text-transform:uppercase;\">Last year</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Where the money went</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"align\":\"center\",\"textColor\":\"muted\",\"fontSize\":\"large\"} -->\n<p class=\"has-text-align-center has-muted-color has-text-color has-large-font-size\">The full accounts are on the Charity Commission register, and we would rather you read them than take our word for it.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"align\":\"wide\",\"className\":\"unapp-grid-4\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"grid\",\"columnCount\":4}} -->\n<div class=\"wp-block-group alignwide unapp-grid-4\">\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"fontSize\":\"xxx-large\",\"style\":{\"typography\":{\"fontWeight\":\"700\",\"lineHeight\":\"1\"}}} -->\n<p class=\"has-xxx-large-font-size\" style=\"font-weight:700;line-height:1;\">11,240</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontWeight\":\"600\"}}} -->\n<p style=\"font-weight:600;\">people helped</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"small\"} -->\n<p class=\"has-muted-color has-text-color has-small-font-size\">Across four food banks and the advice line, in the year to March.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"fontSize\":\"xxx-large\",\"style\":{\"typography\":{\"fontWeight\":\"700\",\"lineHeight\":\"1\"}}} -->\n<p class=\"has-xxx-large-font-size\" style=\"font-weight:700;line-height:1;\">86p</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontWeight\":\"600\"}}} -->\n<p style=\"font-weight:600;\">in every pound</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"small\"} -->\n<p class=\"has-muted-color has-text-color has-small-font-size\">Goes directly to the services. The rest is rent, insurance and audit.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"fontSize\":\"xxx-large\",\"style\":{\"typography\":{\"fontWeight\":\"700\",\"lineHeight\":\"1\"}}} -->\n<p class=\"has-xxx-large-font-size\" style=\"font-weight:700;line-height:1;\">340</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontWeight\":\"600\"}}} -->\n<p style=\"font-weight:600;\">volunteers</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"small\"} -->\n<p class=\"has-muted-color has-text-color has-small-font-size\">Who between them gave about forty thousand hours.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"fontSize\":\"xxx-large\",\"style\":{\"typography\":{\"fontWeight\":\"700\",\"lineHeight\":\"1\"}}} -->\n<p class=\"has-xxx-large-font-size\" style=\"font-weight:700;line-height:1;\">19</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontWeight\":\"600\"}}} -->\n<p style=\"font-weight:600;\">years</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"small\"} -->\n<p class=\"has-muted-color has-text-color has-small-font-size\">Since a church hall, three tables and a rota written on the back of an envelope.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->"
		},
		{
			"slug": "nonprofit-programmes",
			"title": "Charity: programmes",
			"categories": [
				"unapp",
				"unapp_nonprofit"
			],
			"inserter": true,
			"content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);\">\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"680px\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"align\":\"center\",\"textColor\":\"primary\",\"fontFamily\":\"heading\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.12em\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-text-align-center has-primary-color has-text-color has-heading-font-family has-small-font-size\" style=\"font-weight:600;letter-spacing:0.12em;text-transform:uppercase;\">What we run</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Four things, all year</h2>\n<!-- /wp:heading -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"align\":\"wide\",\"className\":\"unapp-grid-4\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"grid\",\"columnCount\":4}} -->\n<div class=\"wp-block-group alignwide unapp-grid-4\">\n<!-- wp:group {\"className\":\"is-style-card\",\"style\":{\"border\":{\"radius\":\"20px\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-card\" style=\"border-radius:20px;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);\">\n<!-- wp:group {\"style\":{\"border\":{\"radius\":\"14px\"},\"spacing\":{\"padding\":{\"top\":\"14px\",\"bottom\":\"14px\",\"left\":\"14px\",\"right\":\"14px\"}}},\"backgroundColor\":\"primary\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group has-primary-background-color has-background\" style=\"border-radius:14px;padding-top:14px;padding-right:14px;padding-bottom:14px;padding-left:14px\">\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"width\":\"24px\",\"height\":\"24px\"} -->\n<figure class=\"wp-block-image size-full is-resized\"><img src=\"{{THEME}}/assets/images/icons/package.svg\" alt=\"\" style=\"width:24px;height:24px;\"/></figure>\n<!-- /wp:image -->\n</div>\n<!-- /wp:group -->\n<!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-large-font-size\">Food banks</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} -->\n<p class=\"has-muted-color has-text-color\">Four sites, open six days between them. A referral helps but nobody is turned away.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"is-style-card\",\"style\":{\"border\":{\"radius\":\"20px\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-card\" style=\"border-radius:20px;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);\">\n<!-- wp:group {\"style\":{\"border\":{\"radius\":\"14px\"},\"spacing\":{\"padding\":{\"top\":\"14px\",\"bottom\":\"14px\",\"left\":\"14px\",\"right\":\"14px\"}}},\"backgroundColor\":\"primary\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group has-primary-background-color has-background\" style=\"border-radius:14px;padding-top:14px;padding-right:14px;padding-bottom:14px;padding-left:14px\">\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"width\":\"24px\",\"height\":\"24px\"} -->\n<figure class=\"wp-block-image size-full is-resized\"><img src=\"{{THEME}}/assets/images/icons/life-buoy.svg\" alt=\"\" style=\"width:24px;height:24px;\"/></figure>\n<!-- /wp:image -->\n</div>\n<!-- /wp:group -->\n<!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-large-font-size\">Debt advice</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} -->\n<p class=\"has-muted-color has-text-color\">Free, confidential and FCA-regulated. Most people call about council tax first.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"is-style-card\",\"style\":{\"border\":{\"radius\":\"20px\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-card\" style=\"border-radius:20px;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);\">\n<!-- wp:group {\"style\":{\"border\":{\"radius\":\"14px\"},\"spacing\":{\"padding\":{\"top\":\"14px\",\"bottom\":\"14px\",\"left\":\"14px\",\"right\":\"14px\"}}},\"backgroundColor\":\"primary\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group has-primary-background-color has-background\" style=\"border-radius:14px;padding-top:14px;padding-right:14px;padding-bottom:14px;padding-left:14px\">\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"width\":\"24px\",\"height\":\"24px\"} -->\n<figure class=\"wp-block-image size-full is-resized\"><img src=\"{{THEME}}/assets/images/icons/heart.svg\" alt=\"\" style=\"width:24px;height:24px;\"/></figure>\n<!-- /wp:image -->\n</div>\n<!-- /wp:group -->\n<!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-large-font-size\">The warm room</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} -->\n<p class=\"has-muted-color has-text-color\">November to March, every weekday, with lunch and somebody to talk to.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"is-style-card\",\"style\":{\"border\":{\"radius\":\"20px\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-card\" style=\"border-radius:20px;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);\">\n<!-- wp:group {\"style\":{\"border\":{\"radius\":\"14px\"},\"spacing\":{\"padding\":{\"top\":\"14px\",\"bottom\":\"14px\",\"left\":\"14px\",\"right\":\"14px\"}}},\"backgroundColor\":\"primary\",\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\"}} -->\n<div class=\"wp-block-group has-primary-background-color has-background\" style=\"border-radius:14px;padding-top:14px;padding-right:14px;padding-bottom:14px;padding-left:14px\">\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"width\":\"24px\",\"height\":\"24px\"} -->\n<figure class=\"wp-block-image size-full is-resized\"><img src=\"{{THEME}}/assets/images/icons/users.svg\" alt=\"\" style=\"width:24px;height:24px;\"/></figure>\n<!-- /wp:image -->\n</div>\n<!-- /wp:group -->\n<!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-large-font-size\">Holiday clubs</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"muted\"} -->\n<p class=\"has-muted-color has-text-color\">Meals and something to do for children on free school meals, every school holiday.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->"
		},
		{
			"slug": "nonprofit-give",
			"title": "Charity: ways to give",
			"categories": [
				"unapp",
				"unapp_nonprofit"
			],
			"inserter": true,
			"content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);\">\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"680px\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"align\":\"center\",\"textColor\":\"primary\",\"fontFamily\":\"heading\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.12em\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-text-align-center has-primary-color has-text-color has-heading-font-family has-small-font-size\" style=\"font-weight:600;letter-spacing:0.12em;text-transform:uppercase;\">Ways to help</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Money or time, both count</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"align\":\"center\",\"textColor\":\"muted\",\"fontSize\":\"large\"} -->\n<p class=\"has-text-align-center has-muted-color has-text-color has-large-font-size\">Gift Aid adds 25p to every pound if you pay UK tax, and costs you nothing.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"align\":\"wide\",\"className\":\"unapp-grid-3\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"grid\",\"columnCount\":3}} -->\n<div class=\"wp-block-group alignwide unapp-grid-3\">\n<!-- wp:group {\"className\":\"is-style-card\",\"style\":{\"border\":{\"radius\":\"20px\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-card\" style=\"border-radius:20px;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);\">\n<!-- wp:paragraph {\"textColor\":\"primary\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.06em\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-primary-color has-text-color has-small-font-size\" style=\"font-weight:600;letter-spacing:0.06em;text-transform:uppercase;\">£10 a month</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"fontSize\":\"xxx-large\",\"style\":{\"typography\":{\"fontWeight\":\"700\",\"lineHeight\":\"1\"}}} -->\n<p class=\"has-xxx-large-font-size\" style=\"font-weight:700;line-height:1;\">£10</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"small\"} -->\n<p class=\"has-muted-color has-text-color has-small-font-size\">Buys a family's worth of tinned goods, every month, without you thinking about it.</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\">\n<!-- wp:button {\"width\":100} -->\n<div class=\"wp-block-button has-custom-width wp-block-button__width-100\"><a class=\"wp-block-button__link wp-element-button\" href=\"#donate\">Choose this</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"is-style-card\",\"style\":{\"border\":{\"radius\":\"20px\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-card\" style=\"border-radius:20px;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);\">\n<!-- wp:paragraph {\"textColor\":\"primary\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.06em\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-primary-color has-text-color has-small-font-size\" style=\"font-weight:600;letter-spacing:0.06em;text-transform:uppercase;\">A one-off gift</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"fontSize\":\"xxx-large\",\"style\":{\"typography\":{\"fontWeight\":\"700\",\"lineHeight\":\"1\"}}} -->\n<p class=\"has-xxx-large-font-size\" style=\"font-weight:700;line-height:1;\">Any</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"small\"} -->\n<p class=\"has-muted-color has-text-color has-small-font-size\">Goes straight into whichever service is emptiest that week.</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\">\n<!-- wp:button {\"width\":100} -->\n<div class=\"wp-block-button has-custom-width wp-block-button__width-100\"><a class=\"wp-block-button__link wp-element-button\" href=\"#donate\">Choose this</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"is-style-card\",\"style\":{\"border\":{\"radius\":\"20px\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group is-style-card\" style=\"border-radius:20px;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);\">\n<!-- wp:paragraph {\"textColor\":\"primary\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.06em\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-primary-color has-text-color has-small-font-size\" style=\"font-weight:600;letter-spacing:0.06em;text-transform:uppercase;\">Give your time</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"fontSize\":\"xxx-large\",\"style\":{\"typography\":{\"fontWeight\":\"700\",\"lineHeight\":\"1\"}}} -->\n<p class=\"has-xxx-large-font-size\" style=\"font-weight:700;line-height:1;\">Free</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"small\"} -->\n<p class=\"has-muted-color has-text-color has-small-font-size\">Two hours a week on a rota. The training takes one morning.</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\">\n<!-- wp:button {\"width\":100} -->\n<div class=\"wp-block-button has-custom-width wp-block-button__width-100\"><a class=\"wp-block-button__link wp-element-button\" href=\"#donate\">Choose this</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->"
		},
		{
			"slug": "nonprofit-trustees",
			"title": "Charity: trustees",
			"categories": [
				"unapp",
				"unapp_nonprofit"
			],
			"inserter": true,
			"content": "<!-- wp:group {\"align\":\"full\",\"className\":\"is-style-section-soft\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull is-style-section-soft\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70);\">\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"680px\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"align\":\"center\",\"textColor\":\"primary\",\"fontFamily\":\"heading\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.12em\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-text-align-center has-primary-color has-text-color has-heading-font-family has-small-font-size\" style=\"font-weight:600;letter-spacing:0.12em;text-transform:uppercase;\">Who runs it</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Three of us, and three hundred of you</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"align\":\"center\",\"textColor\":\"muted\",\"fontSize\":\"large\"} -->\n<p class=\"has-text-align-center has-muted-color has-text-color has-large-font-size\">The trustees are unpaid. There is one salary in the whole organisation.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"align\":\"wide\",\"className\":\"unapp-grid-3\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"layout\":{\"type\":\"grid\",\"columnCount\":3}} -->\n<div class=\"wp-block-group alignwide unapp-grid-3\">\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"width\":\"96px\",\"height\":\"96px\",\"style\":{\"border\":{\"radius\":\"999px\"}}} -->\n<figure class=\"wp-block-image size-full is-resized has-custom-border\"><img src=\"{{THEME}}/assets/images/avatars/avatar-6.svg\" alt=\"Bea Ashford\" style=\"border-radius:999px;width:96px;height:96px;\"/></figure>\n<!-- /wp:image -->\n<!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-large-font-size\">Bea Ashford</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"primary\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.06em\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-primary-color has-text-color has-small-font-size\" style=\"font-weight:600;letter-spacing:0.06em;text-transform:uppercase;\">Chair of trustees</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"small\"} -->\n<p class=\"has-muted-color has-text-color has-small-font-size\">Retired district nurse. Founded the first food bank in 2007.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"width\":\"96px\",\"height\":\"96px\",\"style\":{\"border\":{\"radius\":\"999px\"}}} -->\n<figure class=\"wp-block-image size-full is-resized has-custom-border\"><img src=\"{{THEME}}/assets/images/avatars/avatar-3.svg\" alt=\"Femi Adeyinka\" style=\"border-radius:999px;width:96px;height:96px;\"/></figure>\n<!-- /wp:image -->\n<!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-large-font-size\">Femi Adeyinka</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"primary\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.06em\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-primary-color has-text-color has-small-font-size\" style=\"font-weight:600;letter-spacing:0.06em;text-transform:uppercase;\">Treasurer</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"small\"} -->\n<p class=\"has-muted-color has-text-color has-small-font-size\">Chartered accountant. Publishes the accounts before he has to.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"width\":\"96px\",\"height\":\"96px\",\"style\":{\"border\":{\"radius\":\"999px\"}}} -->\n<figure class=\"wp-block-image size-full is-resized has-custom-border\"><img src=\"{{THEME}}/assets/images/avatars/avatar-9.svg\" alt=\"Sam Lockhart\" style=\"border-radius:999px;width:96px;height:96px;\"/></figure>\n<!-- /wp:image -->\n<!-- wp:heading {\"level\":3,\"fontSize\":\"large\"} -->\n<h3 class=\"wp-block-heading has-large-font-size\">Sam Lockhart</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"textColor\":\"primary\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"fontWeight\":\"600\",\"letterSpacing\":\"0.06em\",\"textTransform\":\"uppercase\"}}} -->\n<p class=\"has-primary-color has-text-color has-small-font-size\" style=\"font-weight:600;letter-spacing:0.06em;text-transform:uppercase;\">Head of services</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"small\"} -->\n<p class=\"has-muted-color has-text-color has-small-font-size\">The only full-time member of staff, and the one who does the rota.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->"
		},
