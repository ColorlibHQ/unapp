{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"lightbox": {
			"enabled": false,
			"allowEditing": true
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#232323",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#5468d8",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#4aca85",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#2a74ca",
					"name": "Accent"
				},
				{
					"slug": "surface",
					"color": "#f5f7fc",
					"name": "Surface"
				},
				{
					"slug": "muted",
					"color": "#6b7280",
					"name": "Muted"
				},
				{
					"slug": "border",
					"color": "#e4e7f0",
					"name": "Border"
				},
				{
					"slug": "dark",
					"color": "#303133",
					"name": "Dark"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-accent",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--accent) 100%)",
					"name": "Primary to Accent"
				},
				{
					"slug": "secondary-to-accent",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--secondary) 0%, var(--wp--preset--color--accent) 100%)",
					"name": "Secondary to Accent"
				},
				{
					"slug": "primary-overlay",
					"gradient": "linear-gradient(135deg, rgba(84,104,216,0.9) 0%, rgba(42,116,202,0.85) 100%)",
					"name": "Primary overlay"
				},
				{
					"slug": "dark-overlay",
					"gradient": "linear-gradient(180deg, rgba(35,35,35,0.55) 0%, rgba(35,35,35,0.85) 100%)",
					"name": "Dark overlay"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "card",
					"name": "Card",
					"shadow": "0 12px 32px -8px color-mix(in srgb, var(--wp--preset--color--dark) 14%, transparent)"
				},
				{
					"slug": "card-strong",
					"name": "Card strong",
					"shadow": "0 28px 56px -20px color-mix(in srgb, var(--wp--preset--color--dark) 34%, transparent)"
				},
				{
					"slug": "glow",
					"name": "Glow",
					"shadow": "0 24px 64px -24px color-mix(in srgb, var(--wp--preset--color--primary) 55%, transparent)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "1"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "2"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "3"
				},
				{
					"slug": "50",
					"size": "clamp(1.5rem, 4vw, 2.5rem)",
					"name": "4"
				},
				{
					"slug": "60",
					"size": "clamp(2rem, 6vw, 4rem)",
					"name": "5"
				},
				{
					"slug": "70",
					"size": "clamp(3rem, 8vw, 6rem)",
					"name": "6"
				},
				{
					"slug": "80",
					"size": "clamp(4rem, 10vw, 8rem)",
					"name": "7"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
